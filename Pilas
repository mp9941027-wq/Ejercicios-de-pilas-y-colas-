    // ---------- Ejercicio 2 ----------
    private static void ejercicio2Parentesis() {
        System.out.println("EJERCICIO 2: VALIDAR PARENTESIS ");
        String[] expresiones = {
                "(a + b) * (c - d)",
                "{{(a)}",
                "{[()]}",
                "((()))",
                ")(",
                "a + b",
                "[(])"
        };
        for (String e : expresiones) {
            System.out.println("Entrada : " + e);
            System.out.println("Salida  : "
                    + (ValidadorParentesis.esValida(e) ? "Valido" : "No válido") + "\n");
        }
    }

   
    private static void ejercicio3Postfija() {
        System.out.println(" EJERCICIO 3: EVALUAR POSTFIJA ");
        String[] postfijas = {
                "2 3 + 5 *",           
                "5 1 2 + 4 * + 3 -",   
                "3 4 +",               
                "10 2 /",              
                "2 3 + 5 * 2 -"        
        };
        for (String p : postfijas) {
            double r = EvaluadorPostfijo.evaluar(p);
            System.out.println("Expresion : " + p);
            System.out.println("Resultado : " + formatear(r) + "\n");
        }
    }

    private static String formatear(double v) {
        if (v == Math.floor(v) && !Double.isInfinite(v)) {
            return String.valueOf((long) v);
        }
        return String.valueOf(v);
    }
}
