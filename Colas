import java.util.LinkedList;
import java.util.List;
import java.util.Queue;

public class ColaPedido {

    private final Queue<Pedido> cola = new LinkedList<>();

    //  agregar pedidos a la cola
    public void agregarPedidos(List<String> ids) {
        for (String id : ids) {
            cola.offer(new Pedido(id));
        }
        System.out.println("\n--- Pedidos agregados a la cola ---");
        mostrarContenido();
    }

    public void mostrarContenido() {
        if (cola.isEmpty()) {
            System.out.println("(Cola vacia)");
            return;
        }
        for (Pedido p : cola) {
            System.out.println("  " + p);
        }
    }

    // procesar el siguiente pedido
    public Pedido procesarSiguiente() {
        Pedido p = cola.poll();
        if (p == null) {
            System.out.println("No hay pedidos pendientes.");
        } else {
            System.out.println("Pedido procesado -> " + p);
        }
        return p;
    }

    // mostrar el siguiente pedido sin procesarlo
    public Pedido verSiguiente() {
        Pedido p = cola.peek();
        if (p == null) {
            System.out.println("No hay pedidos pendientes.");
        } else {
            System.out.println("Siguiente pedido (sin procesar) -> " + p);
        }
        return p;
    }

    // procesar todos los pedidos
    public void procesarTodos() {
        System.out.println("\n--- Procesando todos los pedidos ---");
        if (cola.isEmpty()) {
            System.out.println("No hay pedidos pendientes.");
            return;
        }
        while (!cola.isEmpty()) {
            System.out.println("Procesado: " + cola.poll());
        }
        System.out.println(cola.isEmpty()
                ? "La cola quedo vacia."
                : "ERROR: aun quedan pedidos.");
    }

    // contar pedidos pendientes (sin eliminar)
    public static int contarPendientes(Queue<Pedido> cola) {
        int contador = 0;
        for (Pedido p : cola) {
            contador++;
        }
        return contador;
    }

    public int contarPendientes() {
        return contarPendientes(cola);
    }

    public Queue<Pedido> getCola() { return cola; }
}

