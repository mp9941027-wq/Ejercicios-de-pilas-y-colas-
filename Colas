// Ejercicio 1
public class Cliente {
    private final String nombre;
    private final int ticket;

    public Cliente(String nombre, int ticket) {
        this.nombre = nombre;
        this.ticket = ticket;
    }

    public String getNombre() { return nombre; }
    public int getTicket()    { return ticket; }

    @Override
    public String toString() {
        return "Ticket #" + ticket + " - " + nombre;
    }
}

import java.util.LinkedList;
import java.util.Queue;

public class SistemaAtencion {

    private final Queue<Cliente> fila = new LinkedList<>();
    private int contadorTicket = 1;

    // a) Registrar clientes en la fila
    public void registrarClientes(String[] nombres) {
        for (String nombre : nombres) {
            fila.offer(new Cliente(nombre, contadorTicket++));
        }
        System.out.println("\n--- Fila de clientes registrados ---");
        if (fila.isEmpty()) {
            System.out.println("(La fila está vacía)");
        } else {
            for (Cliente c : fila) {
                System.out.println("  " + c);
            }
        }
    }

    // b) Atender al siguiente cliente
    public void atenderSiguiente() {
        Cliente c = fila.poll();
        if (c == null) {
            System.out.println("La fila está vacía. No hay clientes por atender.");
        } else {
            System.out.println("Atendiendo a -> " + c);
        }
    }

    // c) Verificar el próximo cliente sin atenderlo
    public void verProximo() {
        Cliente c = fila.peek();
        if (c == null) {
            System.out.println("La fila está vacía. No hay próximo cliente.");
        } else {
            System.out.println("Próximo cliente en la fila -> " + c);
        }
    }

    // d) Simular el cierre del día
    public void cierreDelDia() {
        System.out.println("\n--- Cierre del día: atendiendo a todos ---");
        if (fila.isEmpty()) {
            System.out.println("No hay clientes pendientes.");
            return;
        }
        while (!fila.isEmpty()) {
            Cliente c = fila.poll();
            System.out.println("Atendido: " + c);
        }
        System.out.println(fila.isEmpty()
                ? "La fila quedó vacía correctamente."
                : "ERROR: aún quedan clientes.");
    }

    // e) Revisar cantidad de clientes pendientes
    public int contarPendientes() {
        return contarPendientes(fila);
    }

    // Versión que recorre la cola sin eliminarla (sin usar size())
    public static int contarPendientes(Queue<Cliente> cola) {
        int contador = 0;
        for (Cliente c : cola) { // iterar NO elimina
            contador++;
        }
        return contador;
    }

    public Queue<Cliente> getFila() { return fila; }

}


