import java.util.LinkedList;
import java.util.List;
import java.util.Queue;

public class ColaImpresion {

    private final Queue<Impresion> cola = new LinkedList<>();

    // agregar tareas de impresion
    public void agregarTareas(List<Impresion> tareas) {
        for (Impresion t : tareas) {
            cola.offer(t);
        }
        System.out.println("\n--- Tareas agregadas a la cola de impresion ---");
        mostrarContenido();
    }

    public void mostrarContenido() {
        if (cola.isEmpty()) {
            System.out.println("(Cola de impresion vacia)");
            return;
        }
        for (Impresion t : cola) {
            System.out.println("  " + t);
        }
    }

    // procesar la siguiente tarea
    public Impresion procesarSiguiente() {
        Impresion t = cola.poll();
        if (t == null) {
            System.out.println("No hay tareas pendientes en la cola de impresión.");
        } else {
            System.out.println("Imprimiendo -> " + t.getArchivo()
                    + " (" + t.getPaginas() + " paginas)");
        }
        return t;
    }

    // mostrar la proxima tarea sin procesarla
    public Impresion verProxima() {
        Impresion t = cola.peek();
        if (t == null) {
            System.out.println("No hay tareas pendientes en la cola de impresión.");
        } else {
            System.out.println("Proxima tarea (sin procesar) -> " + t);
        }
        return t;
    }

    // simular la impresion de todas las tareas
    public void imprimirTodas() {
        System.out.println("\n--- Imprimiendo todas las tareas ---");
        if (cola.isEmpty()) {
            System.out.println("No hay tareas pendientes.");
            return;
        }
        while (!cola.isEmpty()) {
            Impresion t = cola.poll();
            System.out.println("Impreso: " + t.getArchivo()
                    + " (" + t.getPaginas() + " paginas)");
        }
        System.out.println(cola.isEmpty()
                ? "La cola de impresion quedo vacia."
                : "ERROR: aun quedan tareas.");
    }

    // calcular total de paginas pendientes (sin eliminar)
    public int totalPaginasPendientes() {
        int total = 0;
        for (Impresion t : cola) { 
            total += t.getPaginas();
        }
        return total;
    }

    public Queue<Impresion> getCola() { return cola; }
}


