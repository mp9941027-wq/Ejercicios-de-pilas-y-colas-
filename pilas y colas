import java.util.LinkedList;
import java.util.Queue;

public class Palindromo {

    // Determina si una cadena es palindromo usando una pila y una cola.
     //Se ignoran espacios, puntuacion y mayusculas/minusculas.
     
    public static boolean esPalindromo(String texto) {
        if (texto == null) return false;

        // Normalizar: solo letras y digitos, en minusculas
        String limpio = texto.toLowerCase().replaceAll("[^a-z0-9áéíóúñ]", "");
        if (limpio.isEmpty()) return true;

        Pila<Character> pila = new Pila<>();
        Queue<Character> cola = new LinkedList<>();

        for (char c : limpio.toCharArray()) {
            pila.push(c);   // LIFO: invierte
            cola.offer(c);  // FIFO: orden original
        }

        while (!pila.isEmpty() && !cola.isEmpty()) {
            if (!pila.pop().equals(cola.poll())) {
                return false;
            }
        }
        return true;
    }
}

public class Main {

    public static void main(String[] args) {
        ejercicio1Palindromo();
    }

    //  EJERCICIO 1 
    private static void ejercicio1Palindromo() {
        System.out.println("========= EJERCICIO 1: PALINDROMO =========");
        String[] pruebas = {
                "Anita lava la tina",
                "Hola mundo",
                "A man, a plan, a canal: Panama",
                "12321",
                "Java",
                "¡Anita, lava la tina!",
                ""
        };
        for (String s : pruebas) {
            System.out.printf("\"%-35s\" -> %s%n", s,
                    Palindromo.esPalindromo(s) ? "SI" : "NO");
        }
    }
}

